{
  // Deliberate production uploads only; no GitHub connection or build trigger.
  // Exact website custom domains are attached separately after release approval.
  "name": "techsavvy-website-production",
  "account_id": "a8cd243a690a05d7b1b7055272fa06a2",
  "main": "./cloudflare/production-worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
