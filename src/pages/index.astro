---
import { previewPath } from '../utils/preview-path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import BlogCards from '../components/BlogCards.astro';
import Testimonials from '../components/Testimonials.astro';

const services = [
  { title: 'Your IT department', text: 'Everyday support, monitoring and maintenance for the technology your people depend on.', icon: 'monitor', path: '/outsourced-managed-it' },
  { title: 'IT leadership & planning', text: 'IT director-level guidance that connects technology decisions with your business goals.', icon: 'layers', path: '/outsourced-managed-it#leadership' },
  { title: 'Cybersecurity', text: 'Practical safeguards, updates and security reviews to help protect your business.', icon: 'shield', path: '/outsourced-managed-it#security' },
  { title: 'Backup & recovery', text: 'Managed backups, restore testing and a plan for getting back to work.', icon: 'cloud', path: '/offsite-backup-recovery' },
  { title: 'Cloud & business devices', text: 'Microsoft 365, Google Workspace, AI, cloud applications, computers, servers and mobile-device management shaped to your needs.', icon: 'network', path: '/outsourced-managed-it#devices' },
  { title: 'Vendor coordination', text: 'We work with your technology providers, so you have one partner keeping the pieces connected.', icon: 'people', path: '/outsourced-managed-it#vendors' },
];
---
<BaseLayout title="TechSavvy Consulting | Managed IT & IT Leadership in Tulsa" description="Managed IT for Tulsa County businesses: support, cybersecurity, cloud services, vendor coordination and IT leadership that supports your growth." path="/">
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Managed IT for Tulsa County</span>
          <h1>Your IT department.<br/><em>Your growth partner.</em></h1>
          <p class="hero-lead">We support your people, manage your technology, and coordinate your vendors—so you can focus on what’s next.</p>
          <div class="button-group">
            <a href={previewPath('/contact')} class="button button-primary">Let’s talk about your IT <Icon name="arrow" size={19}/></a>
          </div>
        </div>
        <div class="business-visual" aria-label="TechSavvy connects your people, systems, vendors and IT planning">
          <div class="business-hub"><span class="icon-box"><Icon name="network" size={32}/></span><strong>Keep your tech<br/>working for you.</strong><span>One accountable IT partner.</span></div>
          <div class="business-branches" aria-hidden="true"></div>
          <div class="business-nodes">
            <div><Icon name="monitor" size={23}/><span>People & devices</span></div>
            <div><Icon name="shield" size={23}/><span>Cloud & cybersecurity</span></div>
            <div><Icon name="people" size={23}/><span>Technology vendors</span></div>
            <div><Icon name="layers" size={23}/><span>Planning & growth</span></div>
          </div>
        </div>
      </div>
      <div class="trust-strip">
        <div class="trust-item"><Icon name="pin" size={25}/><div><strong>Right here in Tulsa</strong><span>Serving Tulsa County.</span></div></div>
        <div class="trust-item"><Icon name="monitor" size={25}/><div><strong>Built around your business</strong><span>Typically 10–100 IT users.</span></div></div>
        <div class="trust-item"><Icon name="chat" size={25}/><div><strong>Relationships first</strong><span>Serving businesses since 2015.</span></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading-row">
        <div class="section-heading"><span class="eyebrow">The bigger picture, handled</span><h2>A complete IT relationship.<br/>One clear direction.</h2><p>We manage day-to-day IT and coordinate the specialists behind your business technology.</p></div>
      </div>
      <div class="service-grid">{services.map(service => <article class="service-card"><span class="icon-box"><Icon name={service.icon} size={25}/></span><h3><a href={previewPath(service.path)}>{service.title}</a></h3><p>{service.text}</p><a class="text-link" href={previewPath(service.path)} aria-label={`Explore ${service.title}`}>Learn more <Icon name="arrow" size={16}/></a></article>)}</div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container split-section">
      <div>
        <div class="section-heading"><span class="eyebrow">A partner in your workday</span><h2>Like part of your business.<br/>Invested in your success.</h2><p>You shouldn’t have to be the go-between for every technology issue. We take ownership of the next step and keep you informed.</p></div>
        <div class="value-list">
          <div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>Clear communication</h3><p>Understand what’s happening, what we’re handling and what comes next.</p></div></div>
          <div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>Your vendors, coordinated</h3><p>We work with your software, internet, phone and technology providers.</p></div></div>
          <div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>Attention beyond the next ticket</h3><p>Practical guidance that considers your people, your budget and your goals.</p></div></div>
        </div>
        <a class="text-link" style="margin-top:27px" href={previewPath('/it-support-business-tulsa')}>Why TechSavvy <Icon name="arrow" size={18}/></a>
      </div>
      <figure class="video-card">
        <video controls preload="none" poster={previewPath('/images/home-video-poster.webp')} width="1264" height="1080" aria-label="TechSavvy Consulting introduction"><source src={previewPath('/videos/techsavvy-introduction.mp4')} type="video/mp4"/><p>Your browser does not support this video. <a href={previewPath('/contact')}>Contact TechSavvy</a> for more information.</p></video>
        <figcaption><span><Icon name="play" size={17}/></span> Meet Kyle and get to know TechSavvy.</figcaption>
      </figure>
    </div>
  </section>

  <Testimonials />

  <section class="section" id="growth">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Your partner in growth</span><h2>When you grow, we grow.</h2><p>Your success shapes our priorities. We plan with you, so your technology can support what comes next.</p></div>
      <div class="process-grid">
        <article class="process-item"><span class="process-number">01 / YOUR PEOPLE</span><h3>Ready for the next hire.</h3><p>Plan accounts, devices and access before your people need them.</p></article>
        <article class="process-item"><span class="process-number">02 / YOUR DIRECTION</span><h3>A longer view of IT.</h3><p>Roadmaps, equipment decisions and budgets connected to your business plans.</p></article>
        <article class="process-item"><span class="process-number">03 / YOUR NEXT STEP</span><h3>Improve your business.</h3><p>Simple custom software and practical AI automation to streamline work and help your business grow.</p><a class="text-link" style="margin-top:16px" href={previewPath('/ai-services')}>AI guidance &amp; development <Icon name="arrow" size={17}/></a></article>
      </div>
    </div>
  </section>

  <section class="values-band">
    <div class="container values-band-inner"><div><span class="eyebrow">Why we serve</span><h2>Driven by our love for Jesus.<br/>Committed to serving Tulsa.</h2><p>We love to serve. We use our skills to give back to our Tulsa community and care for the people behind every business.</p></div><a class="text-link" href={previewPath('/about-it-support#why-we-serve')}>What guides our work <Icon name="arrow" size={18}/></a></div>
  </section>

  <section class="section">
    <div class="container"><div class="section-heading-row"><div class="section-heading"><span class="eyebrow">From the TechSavvy blog</span><h2>A little perspective.</h2></div><a href={previewPath('/blog')} class="text-link">Visit the blog <Icon name="arrow" size={18}/></a></div><BlogCards /></div>
  </section>

  <section class="section contact-section" id="request-callback">
    <div class="container contact-grid"><div class="contact-copy"><span class="eyebrow">Let’s start a conversation</span><h2>What’s next<br/>for your business?</h2><p>Tell us where you want to go. Let’s talk about the IT support to help you get there.</p><div class="contact-details"><div class="contact-detail"><Icon name="phone" size={22}/><div><small>Give us a call</small><a class="phone-large" href="tel:+19184002424">(918) 400-2424</a></div></div><div class="contact-detail"><Icon name="mail" size={22}/><div><small>Send us an email</small><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a></div></div><div class="contact-detail"><Icon name="pin" size={22}/><div><small>Right here in Tulsa County</small><p>5840 S Memorial Dr<br/>Tulsa, OK 74145</p></div></div></div></div><ContactForm id="home-callback" callback compact /></div>
  </section>
</BaseLayout>
