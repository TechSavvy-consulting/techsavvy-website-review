---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import BlogCards from '../components/BlogCards.astro';
import Cta from '../components/Cta.astro';
const services = [
  {title:'Managed IT services', text:'Ongoing support, maintenance and guidance—built around your business, your people and your priorities.',icon:'monitor',path:'/outsourced-managed-it'},
  {title:'Proactive IT', text:'Monitoring, updates and thoughtful maintenance to help catch issues before they interrupt the workday.',icon:'settings',path:'/proactive-it'},
  {title:'IT staff collaboration', text:'Extra expertise and practical backup for your internal IT team, with responsibilities clearly defined.',icon:'people',path:'/it-collaboration'},
  {title:'Backup & recovery', text:'A considered approach to protecting business data, testing restores and preparing for the unexpected.',icon:'cloud',path:'/offsite-backup-recovery'},
  {title:'Cloud & Microsoft 365', text:'Help your team work together with the right cloud tools, dependable access and clear support.',icon:'layers',path:'/outsourced-managed-it'},
  {title:'Cybersecurity support', text:'Practical protection, user guidance and ongoing attention to the risks that matter to your business.',icon:'shield',path:'/outsourced-managed-it'},
];
---
<BaseLayout title="TechSavvy Consulting | Friendly Business IT Support in Tulsa" path="/">
  <section class="hero"><div class="container"><div class="hero-grid"><div class="hero-copy"><span class="eyebrow">Tulsa business IT support</span><h1>Keep your tech<br/><em>working for you.</em></h1><p class="hero-lead">Friendly, experienced IT support for businesses with 10–100 computer and device users. Less time sorting out technology. More time doing what you do best.</p><div class="button-group"><a href="/contact" class="button button-primary">Let’s talk about your IT <Icon name="arrow" size={19}/></a><a href="/it-support-for-small-business-tulsa" class="button button-outline">Explore our services</a></div><p class="hero-note"><span class="status-dot"></span> Local people. Practical solutions. Lasting relationships.</p></div><div class="hero-visual"><div class="hero-photo-wrap"><img class="hero-photo" src="/images/kyle-server-room.webp" width="1802" height="872" alt="Kyle Hearn depicted beside server and network equipment" fetchpriority="high" /></div><div class="hero-float"><span class="icon-box"><Icon name="shield" size={24}/></span><div><strong>Your business. Our focus.</strong><small>IT support with a personal connection.</small></div></div><p class="hero-image-caption">TechSavvy brand illustration featuring Kyle Hearn.</p></div></div><div class="trust-strip"><div class="trust-item"><Icon name="pin" size={25}/><div><strong>Right here in Tulsa</strong><span>Local knowledge. Personal service.</span></div></div><div class="trust-item"><Icon name="people" size={25}/><div><strong>Built for your team</strong><span>Businesses with 10–100 IT users.</span></div></div><div class="trust-item"><Icon name="chat" size={25}/><div><strong>Relationships first</strong><span>Serving businesses since 2015.</span></div></div></div></div></section>

  <section class="section"><div class="container"><div class="section-heading-row"><div class="section-heading"><span class="eyebrow">The right help, where you need it</span><h2>IT that fits your business.<br/>People who get to know it.</h2><p>Whether you need an IT partner or an extra set of experienced hands, we help make technology easier to manage.</p></div><a class="text-link" href="/it-support-for-small-business-tulsa">See how we can help <Icon name="arrow" size={18}/></a></div><div class="service-grid">{services.map(service=><article class="service-card"><span class="icon-box"><Icon name={service.icon} size={25}/></span><h3><a href={service.path}>{service.title}</a></h3><p>{service.text}</p><a class="text-link" href={service.path} aria-label={`Explore ${service.title}`}>Learn more <Icon name="arrow" size={16}/></a></article>)}</div></div></section>

  <section class="section section-soft"><div class="container split-section"><div><div class="section-heading"><span class="eyebrow">A better way to work together</span><h2>Support that feels like<br/>part of your team.</h2><p>Good IT starts with listening. We take time to understand how your business works, then shape support around what matters to you.</p></div><div class="value-list"><div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>Friendly, experienced people</h3><p>Approachable support and honest conversations, without the unnecessary jargon.</p></div></div><div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>Practical help, with less disruption</h3><p>Some troubleshooting and repairs can happen in the background while you work. When your involvement is needed, we’ll explain the next step.</p></div></div><div class="value-item"><span class="icon-box"><Icon name="check" size={18}/></span><div><h3>A plan for what comes next</h3><p>Ongoing guidance to help your technology support your business as its needs change.</p></div></div></div><a class="text-link" style="margin-top:27px" href="/it-support-business-tulsa">Get to know our approach <Icon name="arrow" size={18}/></a></div><figure class="video-card"><video controls preload="none" poster="/images/home-video-poster.webp" width="1264" height="1080" aria-label="TechSavvy Consulting introduction"><source src="/videos/techsavvy-introduction.mp4" type="video/mp4"/><p>Your browser does not support this video. <a href="/contact">Contact TechSavvy</a> for more information.</p></video><figcaption><span><Icon name="play" size={17}/></span> A little more about TechSavvy and how we help.</figcaption></figure></div></section>

  <section class="section testimonial-section" id="testimonials"><div class="container testimonial-grid"><div><span class="eyebrow light">Don’t just take our word for it</span><h2>Good IT starts<br/>with trust.</h2><p style="margin-top:20px;font-size:.9rem;max-width:300px">A relationship built around being helpful, responsive and easy to work with.</p></div><div><blockquote><span class="quote-mark" aria-hidden="true">“</span><p>“They do outstanding work and respond very quickly! I highly recommend them to anyone seeking reliable, high-quality IT services.”</p><footer class="quote-person"><span class="quote-logo"><img src="/images/emerge-logo.webp" alt="Emerge Medical" width="187" height="71" loading="lazy"/></span><div><strong>Taryn Schell</strong><span>Emerge Medical</span></div></footer></blockquote><p class="quote-source">Excerpt from the testimonial on TechSavvy’s current website.</p></div></div></section>

  <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">A straightforward start</span><h2>Let’s find the right fit.</h2><p>No complicated pitch. Just a useful conversation about your business and where IT could work better.</p></div><div class="process-grid"><article class="process-item"><span class="process-number">01 / LET’S TALK</span><h3>Tell us what’s happening.</h3><p>Share how your team uses technology, what’s working and what keeps getting in the way.</p></article><article class="process-item"><span class="process-number">02 / MAKE A PLAN</span><h3>Agree on the right approach.</h3><p>We’ll review the fit, discuss priorities and define the services, responsibilities and costs.</p></article><article class="process-item"><span class="process-number">03 / WORK TOGETHER</span><h3>Move forward with clarity.</h3><p>Get a practical plan for onboarding, ongoing support and your next technology decisions.</p></article></div></div></section>

  <section class="section section-pale"><div class="container split-section"><div class="founder-card"><img src="/images/kyle-hearn.webp" alt="Kyle E. Hearn, founder of TechSavvy Consulting" class="founder-photo" width="1254" height="1254" loading="lazy"/><div class="founder-label"><strong>Kyle E. Hearn</strong><span>Founder & Chief Technology Officer</span></div></div><div class="founder-copy"><div class="section-heading"><span class="eyebrow">Local expertise. A personal connection.</span><h2>A business partner,<br/>not just a help desk.</h2></div><p>Technology works better when the people supporting it understand your goals. That’s the approach Kyle brings to TechSavvy.</p><p>Founded in 2015, TechSavvy Consulting helps Tulsa businesses make practical technology decisions and build lasting support relationships.</p><a href="/about-it-support" class="text-link">Meet TechSavvy <Icon name="arrow" size={18}/></a></div></div></section>

  <section class="section"><div class="container"><div class="section-heading-row"><div class="section-heading"><span class="eyebrow">From the TechSavvy blog</span><h2>A little perspective<br/>for a better workday.</h2><p>Practical thoughts on business IT, choosing a provider and planning your next move.</p></div><a href="/blog" class="text-link">Visit the blog <Icon name="arrow" size={18}/></a></div><BlogCards /></div></section>

  <section class="section contact-section" id="request-callback"><div class="container contact-grid"><div class="contact-copy"><span class="eyebrow">Let’s start a conversation</span><h2>What could better IT<br/>look like for you?</h2><p>Tell us a little about your business and the help you need. We’ll take it from there.</p><div class="contact-details"><div class="contact-detail"><Icon name="phone" size={22}/><div><small>Give us a call</small><a class="phone-large" href="tel:+19184002424">(918) 400-2424</a></div></div><div class="contact-detail"><Icon name="mail" size={22}/><div><small>Send us an email</small><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a></div></div><div class="contact-detail"><Icon name="pin" size={22}/><div><small>Right here in Tulsa</small><p>5840 S Memorial Dr<br/>Tulsa, OK 74145</p></div></div></div></div><ContactForm id="home-callback" callback compact /></div></section>
  <Cta />
</BaseLayout>
