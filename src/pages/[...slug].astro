---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import BlogCards from '../components/BlogCards.astro';
import StandardPages from '../components/StandardPages.astro';
import BlogArticle from '../components/BlogArticle.astro';
import { servicePages } from '../data/services';
import { posts } from '../data/blog';
import inventory from '../data/source-inventory.json';

export function getStaticPaths() {
  const fixed = ['about-it-support','blog','tulsa-it-faq','contact','accessibility-statement','english-privacy-policy','it-support-for-small-business-tulsa','thank-you'];
  return [...fixed, ...servicePages.map(p=>p.path.slice(1)), ...posts.map(p=>p.path.slice(1))].map(slug=>({params:{slug}}));
}
const path = '/' + Astro.params.slug;
const service = servicePages.find(p=>p.path===path);
const post = posts.find(p=>p.path===path);
const source = inventory.pages.find(p=>p.path===path);
const isPrivacy = path==='/english-privacy-policy';
const isAccessibility = path==='/accessibility-statement';
const serviceIndex = path==='/it-support-for-small-business-tulsa';
const title = source?.title || (path==='/thank-you'?'Thank You | TechSavvy Review Site':'TechSavvy Consulting');
const description = source?.description || post?.excerpt || 'Practical, personal IT support for Tulsa businesses.';
const legalBlocks = (source?.contentBlocks || []).filter(block=>block.tag!=='h1');
const articleSchema = post && { '@context':'https://schema.org','@type':'BlogPosting',headline:post.title,datePublished:post.date,author:{'@type':'Person',name:post.author},publisher:{'@type':'Organization',name:'TechSavvy Consulting, LLC'},mainEntityOfPage:'https://www.techsavvy.consulting'+post.path,image:'https://www.techsavvy.consulting'+post.image };
---
<BaseLayout title={title} description={description} path={path} article={!!post}>
  {post && <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g,'\\u003c')} /></Fragment>}
  {service && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/it-support-for-small-business-tulsa">Services</a><span aria-hidden="true">/</span><span>{service.title}</span></div><div class="page-hero-grid"><div><span class="eyebrow">{service.eyebrow}</span><h1>{service.headline}</h1><p class="lead">{service.summary}</p><div class="button-group"><a href="/contact" class="button button-primary">Let’s talk about your IT <Icon name="arrow" size={18}/></a><a href="tel:+19184002424" class="text-link">(918) 400-2424</a></div></div><div class="service-hero-media"><img src="/images/kyle-server-room.webp" alt="Kyle Hearn depicted beside server and network equipment" width="1802" height="872" /></div></div></div></section>
    <div class="container benefit-strip">{service.benefits.map(benefit=><div><Icon name="check" size={20}/><span>{benefit}</span></div>)}</div>
    <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">Practical support. Clear expectations.</span><h2>The help your business needs.</h2><p>We shape the services around your environment, then agree on responsibilities, coverage and the way we’ll work together.</p></div><div class="service-grid">{service.cards.map(card=><article class="service-card compact-card"><span class="icon-box"><Icon name={card.icon} size={24}/></span><h3>{card.title}</h3><p>{card.text}</p></article>)}</div></div></section>
    <section class="section section-soft"><div class="container service-page-faq"><div class="section-heading"><span class="eyebrow">A few useful answers</span><h2>Good questions.<br/>Straight answers.</h2><p>Every business is different. If your question isn’t here, let’s talk it through.</p><a href="/tulsa-it-faq" class="text-link" style="margin-top:23px">More common questions <Icon name="arrow" size={18}/></a></div><div class="faq-list">{service.faq.map(item=><details class="faq-item"><summary>{item.question}</summary><div>{item.answer}</div></details>)}</div></div></section><Cta />
  </>}
  {serviceIndex && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Services</span></div><span class="eyebrow">IT that fits your business</span><h1>The right support.<br/>A more productive workday.</h1><p class="lead">From everyday help to long-term planning, TechSavvy supports the technology your people depend on. We’ll help you find the right mix for your team.</p></div></section>
    <section class="section"><div class="container service-grid">{servicePages.map(item=><article class="service-card"><span class="icon-box"><Icon name={item.icon} size={26}/></span><h2 style="font-size:1.35rem;margin-top:23px"><a href={item.path}>{item.title}</a></h2><p>{item.summary}</p><a class="text-link" href={item.path}>Explore this service <Icon name="arrow" size={17}/></a></article>)}<article class="service-card"><span class="icon-box"><Icon name="chat" size={26}/></span><h2 style="font-size:1.35rem;margin-top:23px">Not sure where to start?</h2><p>You don’t need a technical diagnosis to have a useful conversation. Tell us what’s getting in the way and we’ll help identify the next step.</p><a class="text-link" href="/contact">Talk with TechSavvy <Icon name="arrow" size={17}/></a></article></div></section><Cta />
  </>}
  <StandardPages path={path} />
  {path==='/blog' && <><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Blog</span></div><span class="eyebrow">The TechSavvy blog</span><h1>Useful ideas.<br/>Practical perspective.</h1><p class="lead">Thoughts on business technology, IT support and making informed decisions for your team.</p></div></section><section class="section"><div class="container"><BlogCards /><p class="article-note">These are TechSavvy’s existing articles, with their original publication dates. The review edition streamlines the text and flags dated guidance; it does not present older posts as new announcements.</p></div></section><Cta /></>}
  {post && <BlogArticle post={post} />}
  {(isPrivacy || isAccessibility) && <><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>{isPrivacy?'Privacy':'Accessibility'}</span></div><span class="eyebrow">Clear information. Thoughtful design.</span><h1>{isPrivacy?'Privacy policy':'Accessibility statement'}</h1></div></section><section class="section"><div class="container legal-content"><div class="preview-notice"><strong>Review-site notice.</strong> The text below is the current Wix website’s published {isPrivacy?'privacy policy':'accessibility statement'}, retained for migration review. References to Wix describe the existing production site. This separate preview has inactive forms and no optional analytics or advertising tags. Provider-specific wording will be reviewed once a host and production features are selected.</div>{legalBlocks.map(block=>/h[2-4]/.test(block.tag)?<h2>{block.text}</h2>:block.tag==='h5'||block.tag==='h6'?<h3>{block.text}</h3>:block.tag==='li'?<p class="legal-list-item">• {block.text}</p>:<p>{block.text}</p>)}</div></section></>}
  {path==='/thank-you' && <section class="section section-pale"><div class="container empty-state"><span class="eyebrow">Confirmation-page design preview</span><h1 style="margin-top:15px">Thanks for reaching out.</h1><p>This is the proposed confirmation screen. No message has been submitted. Forms on this review site are disabled.</p><a href="/" class="button button-primary">Back to Home <Icon name="arrow" size={18}/></a></div></section>}
</BaseLayout>
