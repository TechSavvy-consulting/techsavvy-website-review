---
import { previewPath } from '../utils/preview-path';
import { socialImageForPost } from '../utils/social-image';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import BlogCards from '../components/BlogCards.astro';
import StandardPages from '../components/StandardPages.astro';
import BlogArticle from '../components/BlogArticle.astro';
import PolicyContent from '../components/PolicyContent.astro';
import { servicePages } from '../data/services';
import { posts, allPosts } from '../data/blog';
import inventory from '../data/source-inventory.json';

export function getStaticPaths() {
  const fixed = ['about-it-support','blog','tulsa-it-faq','contact','accessibility-statement','english-privacy-policy','it-support-for-small-business-tulsa','it-collaboration','thank-you'];
  return [...fixed, ...servicePages.map(p=>p.path.slice(1)), ...posts.map(p=>p.path.slice(1))].map(slug=>({params:{slug}}));
}
const path = '/' + Astro.params.slug;
const service = servicePages.find(p=>p.path===path);
const post = posts.find(p=>p.path===path);
const socialImage = post ? socialImageForPost(post) : undefined;
const source = inventory.pages.find(p=>p.path===path);
const isPrivacy = path==='/english-privacy-policy';
const isAccessibility = path==='/accessibility-statement';
const retiredServicePage = ['/it-support-for-small-business-tulsa','/it-collaboration'].includes(path);
const serviceDestination = previewPath('/outsourced-managed-it');
const pageMetadata: Record<string, {title: string; description: string}> = {
  '/outsourced-managed-it': {title:'Managed IT Services in Tulsa | TechSavvy Consulting', description:'Managed IT for Tulsa-area organizations with 10–100 computer/device users. Local support, cybersecurity, backup oversight and practical IT guidance.'},
  '/proactive-it': {title:'Proactive IT Maintenance & Monitoring in Tulsa | TechSavvy Consulting', description:'Proactive IT care for Tulsa businesses, including monitoring, tested updates, security checks and backup oversight as part of managed support.'},
  '/offsite-backup-recovery': {title:'Business Backup & Recovery in Tulsa | TechSavvy Consulting', description:'Business backup and recovery planning for Tulsa organizations, with local and offsite options, monitoring and restore testing around your priorities.'},
  '/it-support-business-tulsa': {title:'Why TechSavvy | Tulsa IT Support & Consulting', description:'Meet a Tulsa IT partner invested in your business: friendly support, practical guidance, vendor coordination and relationships built for long-term growth.'},
  '/about-it-support': {title:'About TechSavvy Consulting | Your Tulsa County IT Partner', description:'Get to know TechSavvy: practical IT leadership, customer care, vendor coordination and a commitment to serving Jesus and the Tulsa community.'},
  '/contact': {title:'Talk About Your IT Plan | TechSavvy Consulting, Tulsa', description:'Talk with TechSavvy about managed IT, IT leadership and vendor coordination for your Tulsa County business. Start with your goals and what comes next.'},
  '/it-support-for-small-business-tulsa': {title:'Managed IT Services | TechSavvy Consulting', description:'Continue to TechSavvy managed IT services: connected support, proactive care and IT leadership for your business.'},
  '/it-collaboration': {title:'Managed IT Services | TechSavvy Consulting', description:'Continue to TechSavvy managed IT services: connected support, proactive care and IT leadership for your business.'},
  '/tulsa-it-faq': {title:'Managed IT Questions Answered | TechSavvy Tulsa', description:'Learn about TechSavvy managed IT, IT director-level guidance, vendor coordination and support arrangements for Tulsa County organizations.'},
  '/english-privacy-policy': {title:'Privacy Policy | TechSavvy Consulting', description:'How TechSavvy handles website inquiries, the providers supporting this site, and how to contact us about privacy.'},
  '/accessibility-statement': {title:'Accessibility | TechSavvy Consulting', description:'Accessibility features on the TechSavvy website and ways to get help accessing our information and services.'},
  '/thank-you': {title:'Thank You | TechSavvy Consulting', description:'Contact TechSavvy Consulting about your business technology, or call us when you need a more immediate conversation.'},
};
// Keep search/share metadata independent of the approved visible service copy.
const title = pageMetadata[path]?.title || (service ? `${service.title} | TechSavvy Consulting` : post ? `${post.title} | TechSavvy Consulting` : source?.title || 'TechSavvy Consulting');
const description = pageMetadata[path]?.description || service?.summary || post?.excerpt || source?.description || 'Practical IT support and leadership for Tulsa County businesses.';
const articleSchema = post && { '@context':'https://schema.org','@type':'BlogPosting',headline:post.title,datePublished:post.date,dateModified:post.updatedDate || post.date,author:{'@type':'Person',name:post.author},publisher:{'@id':'https://www.techsavvy.consulting/#organization'},mainEntityOfPage:'https://www.techsavvy.consulting'+post.path,image:new URL(previewPath(socialImage!.path),Astro.site).href };
const faqIntroductions: Record<string, {eyebrow: string; heading: string; text: string}> = {
  '/outsourced-managed-it': {eyebrow:'Finding your fit', heading:'Let’s talk through the possibilities.', text:'A good IT relationship starts with understanding what works for your business. Here are a few helpful starting points.'},
  '/proactive-it': {eyebrow:'A closer look at ongoing care', heading:'Know what’s working behind the scenes.', text:'See how regular attention keeps your technology connected to the way your people work.'},
  '/offsite-backup-recovery': {eyebrow:'Planning for continuity', heading:'Build confidence in your next step.', text:'Your backup and recovery plan should reflect what matters to your business. These answers explain where we start.'},
  '/it-support-business-tulsa': {eyebrow:'Getting to know each other', heading:'A good relationship starts with a conversation.', text:'Here’s a little more about how we listen, work alongside your people and help you move forward.'},
};
const faqIntroduction = faqIntroductions[path];
---
<BaseLayout title={title} description={description} path={path} canonicalPath={retiredServicePage ? '/outsourced-managed-it' : path} article={!!post} socialImage={socialImage}>
  <Fragment slot="head">
    {post && <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g,'\\u003c')} />}
    {retiredServicePage && <>
      <meta http-equiv="refresh" content={`0;url=${serviceDestination}`} />
      <script is:inline define:vars={{ destination: serviceDestination }}>
        window.location.replace(destination + window.location.search + window.location.hash);
      </script>
    </>}
  </Fragment>
  {service && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span>Services</span><span aria-hidden="true">/</span><span>{service.title}</span></div><div class="page-hero-grid"><div><span class="eyebrow">{service.eyebrow}</span><h1>{service.headline}</h1><p class="lead">{service.summary}</p><div class="button-group"><a href={previewPath('/contact')} class="button button-primary">Let’s talk about your IT <Icon name="arrow" size={18}/></a><a href="tel:+19184002424" class="text-link">(918) 400-2424</a></div></div><div class="service-hero-media service-hero-diagram" aria-hidden="true"><span class="service-visual-mark"><Icon name={service.icon} size={35}/></span><strong class="service-visual-title">Your business,<br/>supported.</strong><div class="service-visual-points">{(path==='/offsite-backup-recovery'?[['cloud','Backup health'],['check','Restore testing'],['layers','Recovery planning']]:path==='/proactive-it'?[['monitor','Monitoring'],['settings','Tested updates'],['shield','Security & backups']]:path==='/it-support-business-tulsa'?[['people','Your goals'],['chat','Clear guidance'],['check','Lasting relationships']]:[['chat','Everyday support'],['shield','Proactive care'],['layers','IT leadership']]).map(([icon,label])=><div class="service-visual-point"><Icon name={icon} size={21}/><span>{label}</span></div>)}</div></div></div></div></section>
    <div class="container benefit-strip">{service.benefits.map(benefit=><div><Icon name="check" size={20}/><span>{benefit}</span></div>)}</div>
    {'plans' in service && <section class="section section-pale" id="plans"><div class="container"><div class="section-heading"><span class="eyebrow">Two ways to work together</span><h2>Choose the support that fits.</h2><p>Both Full and Remote Managed IT include Proactive IT: monitoring, maintenance, tested updates, security checks and backup oversight.</p><a class="text-link" style="margin-top:18px" href={previewPath('/proactive-it')}>See what Proactive IT includes <Icon name="arrow" size={17}/></a></div><div class="split-section">{service.plans.map(plan=><article class="service-card compact-card"><span class="icon-box"><Icon name={plan.icon} size={24}/></span><h3>{plan.title}</h3><p>{plan.text}</p></article>)}</div></div></section>}
    <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">{path==='/proactive-it'?'Included with managed IT':path==='/it-support-business-tulsa'?'A relationship worth building':path==='/offsite-backup-recovery'?'Backup protection and recovery':'IT that supports your next step.'}</span><h2>{path==='/proactive-it'?'Ongoing care for the systems you count on.':path==='/offsite-backup-recovery'?'Protect your data. Plan your recovery.':'Your people. Your systems. Your goals.'}</h2><p>{path==='/proactive-it'?'Monitoring, tested updates, security and backup care work together as part of your managed service.':path==='/it-support-business-tulsa'?'We learn how your business works, care for your people and build trust through clear answers and follow-through.':path==='/offsite-backup-recovery'?'Keep important data backed up, check that copies are usable and plan how to restore the systems your business needs.':'Connect everyday IT care with the priorities that move your business forward.'}</p></div><div class="service-grid">{service.cards.map(card=><article class="service-card compact-card" id={'id' in card ? card.id : undefined}><span class="icon-box"><Icon name={card.icon} size={24}/></span><h3>{card.title}</h3><p>{card.text}</p></article>)}</div></div></section>
    <section class="section section-soft"><div class="container service-page-faq"><div class="section-heading"><span class="eyebrow">{faqIntroduction.eyebrow}</span><h2>{faqIntroduction.heading}</h2><p>{faqIntroduction.text}</p><a href={previewPath('/tulsa-it-faq')} class="text-link" style="margin-top:23px">More common questions <Icon name="arrow" size={18}/></a></div><div class="faq-list">{service.faq.map(item=><details class="faq-item"><summary>{item.question}</summary><div>{item.answer}</div></details>)}</div></div></section><Cta />
  </>}
  {retiredServicePage && <section class="section section-pale"><div class="container empty-state"><span class="eyebrow">Managed IT services</span><h1 style="margin-top:15px">Your next stop: connected IT care.</h1><p>Explore our connected support, proactive care and IT leadership on the Managed IT Services page. If you are not redirected automatically, continue below.</p><a href={serviceDestination} class="button button-primary">View Managed IT Services <Icon name="arrow" size={18}/></a></div></section>}
  <StandardPages path={path} />
  {path==='/blog' && <><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span>/</span><span>Blog</span></div><span class="eyebrow">The TechSavvy blog</span><h1>Useful ideas.<br/>Practical perspective.</h1><p class="lead">Thoughts on business technology, IT support and making informed decisions for your team.</p></div></section><section class="section"><div class="container"><BlogCards posts={allPosts} /></div></section><Cta /></>}
  {post && <BlogArticle post={post} />}
  {(isPrivacy || isAccessibility) && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span>/</span><span>{isPrivacy?'Privacy':'Accessibility'}</span></div><span class="eyebrow">Clear information. Thoughtful design.</span><h1>{isPrivacy?'Privacy policy':'Accessibility statement'}</h1></div></section>
    <section class="section"><div class="container legal-content">
      <PolicyContent path={path} />
    </div></section>
  </>}
  {path==='/thank-you' && <section class="section section-pale"><div class="container empty-state"><span class="eyebrow">Let’s keep the conversation going</span><h1 style="margin-top:15px">Thanks for reaching out.</h1><p>We look forward to learning about your business. A successfully submitted inquiry is confirmed on the contact form itself. If you need a more immediate conversation, call <a href="tel:+19184002424">(918) 400-2424</a>.</p><a href={previewPath('/')} class="button button-primary">Back to Home <Icon name="arrow" size={18}/></a></div></section>}
</BaseLayout>
