---
import { previewPath } from '../utils/preview-path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import BlogCards from '../components/BlogCards.astro';
import StandardPages from '../components/StandardPages.astro';
import BlogArticle from '../components/BlogArticle.astro';
import { servicePages } from '../data/services';
import { posts } from '../data/blog';
import inventory from '../data/source-inventory.json';

export function getStaticPaths() {
  const fixed = ['about-it-support','blog','tulsa-it-faq','contact','accessibility-statement','english-privacy-policy','it-support-for-small-business-tulsa','thank-you'];
  return [...fixed, ...servicePages.map(p=>p.path.slice(1)), ...posts.map(p=>p.path.slice(1))].map(slug=>({params:{slug}}));
}
const path = '/' + Astro.params.slug;
const service = servicePages.find(p=>p.path===path);
const post = posts.find(p=>p.path===path);
const source = inventory.pages.find(p=>p.path===path);
const isPrivacy = path==='/english-privacy-policy';
const isAccessibility = path==='/accessibility-statement';
const serviceIndex = path==='/it-support-for-small-business-tulsa';
const pageMetadata: Record<string, {title: string; description: string}> = {
  '/about-it-support': {title:'About TechSavvy Consulting | Your Tulsa County IT Partner', description:'Get to know TechSavvy: practical IT leadership, customer care, vendor coordination and a commitment to serving Jesus and the Tulsa community.'},
  '/contact': {title:'Talk About Your IT Plan | TechSavvy Consulting, Tulsa', description:'Talk with TechSavvy about managed IT, IT leadership and vendor coordination for your Tulsa County business. Start with your goals and what comes next.'},
  '/it-support-for-small-business-tulsa': {title:'Managed IT, IT Leadership & Business Technology | TechSavvy Tulsa', description:'Explore connected IT support for Tulsa County businesses: managed and co-managed IT, cybersecurity, backup, cloud services, devices and vendor coordination.'},
  '/tulsa-it-faq': {title:'Managed IT Questions Answered | TechSavvy Tulsa', description:'Learn about TechSavvy managed IT, virtual CIO guidance, vendor coordination and support arrangements for Tulsa County organizations.'},
};
const title = service ? `${service.title} | TechSavvy Consulting` : post ? `${post.title} | TechSavvy Consulting` : pageMetadata[path]?.title || source?.title || (path==='/thank-you'?'Thank You | TechSavvy Review Site':'TechSavvy Consulting');
const description = service?.summary || post?.excerpt || pageMetadata[path]?.description || source?.description || 'Practical IT support and leadership for Tulsa County businesses.';
const legalBlocks = (source?.contentBlocks || []).filter(block=>block.tag!=='h1');
const articleSchema = post && { '@context':'https://schema.org','@type':'BlogPosting',headline:post.title,datePublished:post.date,dateModified:post.updatedDate || post.date,author:{'@type':'Person',name:post.author},publisher:{'@type':'Organization',name:'TechSavvy Consulting, LLC'},mainEntityOfPage:'https://www.techsavvy.consulting'+post.path,image:new URL(previewPath(post.image),Astro.site).href };
---
<BaseLayout title={title} description={description} path={path} article={!!post}>
  {post && <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g,'\\u003c')} /></Fragment>}
  {service && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><a href={previewPath('/it-support-for-small-business-tulsa')}>Services</a><span aria-hidden="true">/</span><span>{service.title}</span></div><div class="page-hero-grid"><div><span class="eyebrow">{service.eyebrow}</span><h1>{service.headline}</h1><p class="lead">{service.summary}</p><div class="button-group"><a href={previewPath('/contact')} class="button button-primary">Let’s talk about your IT <Icon name="arrow" size={18}/></a><a href="tel:+19184002424" class="text-link">(918) 400-2424</a></div></div><div class="service-hero-media service-hero-diagram" aria-hidden="true"><span class="service-visual-mark"><Icon name={service.icon} size={35}/></span><strong class="service-visual-title">Your business,<br/>supported.</strong><div class="service-visual-points">{(path==='/offsite-backup-recovery'?[['cloud','Backup health'],['check','Restore testing'],['layers','Recovery planning']]:path==='/proactive-it'?[['monitor','Monitoring'],['settings','Tested updates'],['shield','Security & backups']]:path==='/it-collaboration'?[['chat','Remote help desk'],['settings','Proactive system care'],['people','Local hands-on support']]:path==='/it-support-business-tulsa'?[['people','Your goals'],['chat','Clear guidance'],['check','Lasting relationships']]:[['chat','Everyday support'],['shield','Proactive care'],['layers','IT leadership']]).map(([icon,label])=><div class="service-visual-point"><Icon name={icon} size={21}/><span>{label}</span></div>)}</div></div></div></div></section>
    <div class="container benefit-strip">{service.benefits.map(benefit=><div><Icon name="check" size={20}/><span>{benefit}</span></div>)}</div>
    {'plans' in service && <section class="section section-pale" id="plans"><div class="container"><div class="section-heading"><span class="eyebrow">Two ways to work together</span><h2>Choose the support that fits.</h2><p>Both Full and Remote Managed IT include Proactive IT: monitoring, maintenance, tested updates, security checks and backup oversight.</p><a class="text-link" style="margin-top:18px" href={previewPath('/proactive-it')}>See what Proactive IT includes <Icon name="arrow" size={17}/></a></div><div class="split-section">{service.plans.map(plan=><article class="service-card compact-card"><span class="icon-box"><Icon name={plan.icon} size={24}/></span><h3>{plan.title}</h3><p>{plan.text}</p></article>)}</div></div></section>}
    <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">{path==='/proactive-it'?'Included with managed IT':path==='/it-collaboration'?'Your remote IT operation':path==='/it-support-business-tulsa'?'A relationship worth building':'IT that supports your next step.'}</span><h2>{path==='/proactive-it'?'Ongoing care for the systems you count on.':path==='/it-collaboration'?'Remote expertise. Local hands-on care.':'Your people. Your systems. Your goals.'}</h2><p>{path==='/proactive-it'?'Monitoring, tested updates, security and backup care work together as part of your managed service.':path==='/it-collaboration'?'We handle remote support and ongoing system care, working closely with the people who know your location.':path==='/it-support-business-tulsa'?'We learn how your business works, care for your people and build trust through clear answers and follow-through.':'Connect everyday IT care with the priorities that move your business forward.'}</p></div><div class="service-grid">{service.cards.map(card=><article class="service-card compact-card" id={'id' in card ? card.id : undefined}><span class="icon-box"><Icon name={card.icon} size={24}/></span><h3>{card.title}</h3><p>{card.text}</p></article>)}</div></div></section>
    <section class="section section-soft"><div class="container service-page-faq"><div class="section-heading"><span class="eyebrow">A few useful answers</span><h2>Good questions.<br/>Straight answers.</h2><p>Every business is different. If your question isn’t here, let’s talk it through.</p><a href={previewPath('/tulsa-it-faq')} class="text-link" style="margin-top:23px">More common questions <Icon name="arrow" size={18}/></a></div><div class="faq-list">{service.faq.map(item=><details class="faq-item"><summary>{item.question}</summary><div>{item.answer}</div></details>)}</div></div></section><Cta />
  </>}
  {serviceIndex && <>
    <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span>/</span><span>Services</span></div><span class="eyebrow">Your IT department and growth partner</span><h1>The right IT support.<br/>A clear path forward.</h1><p class="lead">Bring everyday support, proactive care and IT leadership together. Choose a full IT department relationship or remote managed support connected with your onsite team.</p></div></section>
    <section class="section"><div class="container service-grid">{servicePages.map(item=><article class="service-card"><span class="icon-box"><Icon name={item.icon} size={26}/></span><h2 style="font-size:1.35rem;margin-top:23px"><a href={previewPath(item.path)}>{item.title}</a></h2><p>{item.summary}</p><a class="text-link" href={previewPath(item.path)}>Explore this service <Icon name="arrow" size={17}/></a></article>)}<article class="service-card"><span class="icon-box"><Icon name="chat" size={26}/></span><h2 style="font-size:1.35rem;margin-top:23px">Not sure where to start?</h2><p>Tell us where technology is slowing you down and where your business is heading. We’ll help you choose the next step.</p><a class="text-link" href={previewPath('/contact')}>Talk with TechSavvy <Icon name="arrow" size={17}/></a></article></div></section><Cta />
  </>}
  <StandardPages path={path} />
  {path==='/blog' && <><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span>/</span><span>Blog</span></div><span class="eyebrow">The TechSavvy blog</span><h1>Useful ideas.<br/>Practical perspective.</h1><p class="lead">Thoughts on business technology, IT support and making informed decisions for your team.</p></div></section><section class="section"><div class="container"><BlogCards /><p class="article-note">Explore our latest guidance below. Refreshed articles show their updated dates and retain their original publication dates. Looking for our earlier Windows guidance? <a href={previewPath('/post/windows11-upgrade-essential')}>Read the archived Windows 11 article.</a></p></div></section><Cta /></>}
  {post && <BlogArticle post={post} />}
  {(isPrivacy || isAccessibility) && <><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={previewPath('/')}>Home</a><span>/</span><span>{isPrivacy?'Privacy':'Accessibility'}</span></div><span class="eyebrow">Clear information. Thoughtful design.</span><h1>{isPrivacy?'Privacy policy':'Accessibility statement'}</h1></div></section><section class="section"><div class="container legal-content"><div class="preview-notice"><strong>Review-site notice.</strong> The text below is the current Wix website’s published {isPrivacy?'privacy policy':'accessibility statement'}, retained for migration review. References to Wix describe the existing production site. This separate preview has inactive forms and no optional analytics or advertising tags. Provider-specific wording will be reviewed once a host and production features are selected.</div>{legalBlocks.map(block=>/h[2-4]/.test(block.tag)?<h2>{block.text}</h2>:block.tag==='h5'||block.tag==='h6'?<h3>{block.text}</h3>:block.tag==='li'?<p class="legal-list-item">• {block.text}</p>:<p>{block.text}</p>)}</div></section></>}
  {path==='/thank-you' && <section class="section section-pale"><div class="container empty-state"><span class="eyebrow">Confirmation-page design preview</span><h1 style="margin-top:15px">Thanks for reaching out.</h1><p>This is the proposed confirmation screen. No message has been submitted. Forms on this review site are disabled.</p><a href={previewPath('/')} class="button button-primary">Back to Home <Icon name="arrow" size={18}/></a></div></section>}
</BaseLayout>
