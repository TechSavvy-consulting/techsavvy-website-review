---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const { title = 'TechSavvy Consulting | Tulsa Business IT Support', description = 'Friendly, experienced IT support for Tulsa businesses with 10–100 computer and device users.', path = '/', article = false } = Astro.props;
const canonical = new URL(path, 'https://www.techsavvy.consulting').href;
const current = String(path).replace(/\/$/, '') || '/';
const services = [
  {href:'/outsourced-managed-it', label:'Managed IT services'},
  {href:'/proactive-it', label:'Proactive IT'},
  {href:'/it-collaboration', label:'IT staff collaboration'},
  {href:'/offsite-backup-recovery', label:'Backup & recovery'},
  {href:'/it-support-business-tulsa', label:'Our approach'},
];
const serviceActive = ['/it-support-for-small-business-tulsa', ...services.map(x=>x.href)].includes(current);
const schema = { '@context':'https://schema.org', '@type':'ProfessionalService', name:'TechSavvy Consulting, LLC', url:'https://www.techsavvy.consulting/', image:'https://www.techsavvy.consulting/images/kyle-server-room.webp', telephone:'+19184002424', email:'sales@techsavvy.consulting', foundingDate:'2015', address:{'@type':'PostalAddress',streetAddress:'5840 S Memorial Dr',addressLocality:'Tulsa',addressRegion:'OK',postalCode:'74145',addressCountry:'US'}, areaServed:{'@type':'City',name:'Tulsa'}, openingHours:['Mo-Fr 08:00-17:00'] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14324d" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="TechSavvy Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.techsavvy.consulting/images/kyle-server-room.webp" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <div class="review-banner"><span class="review-pill">REVIEW SITE</span><span>A new look for TechSavvy · Design preview · Forms disabled</span></div>
    <div class="utility-bar"><div class="container utility-inner"><span><Icon name="pin" size={14} /> Tulsa, Oklahoma</span><span class="utility-hours">Mon–Fri, 8am–5pm <span class="utility-divider">|</span> After-hours support according to your service plan</span><a href="https://anydesk.com/en/downloads/windows" target="_blank" rel="noopener noreferrer">Client remote support <span aria-hidden="true">↗</span></a></div></div>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="TechSavvy Consulting home"><img src="/images/techsavvy-logo.webp" width="608" height="170" alt="TechSavvy Consulting" /></a>
        <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation"><Icon name="menu" size={25} /><span>Menu</span></button>
        <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation">
          <a href="/" class:list={{active:current==='/'}} aria-current={current==='/'?'page':undefined}>Home</a>
          <details class="nav-dropdown"><summary class:list={{active:serviceActive}}>Services <span aria-hidden="true">⌄</span></summary><div class="dropdown-panel"><a href="/it-support-for-small-business-tulsa">Explore all services <span>↗</span></a>{services.map(item=><a href={item.href} aria-current={current===item.href?'page':undefined}>{item.label}</a>)}</div></details>
          <a href="/about-it-support" class:list={{active:current==='/about-it-support'}} aria-current={current==='/about-it-support'?'page':undefined}>About</a>
          <a href="/#testimonials">Testimonials</a>
          <a href="/blog" class:list={{active:current==='/blog'||article}} aria-current={current==='/blog'?'page':undefined}>Blog</a>
          <a href="/contact" class="button button-primary nav-cta">Let’s talk <Icon name="arrow" size={17}/></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand"><a href="/" aria-label="TechSavvy Consulting home"><img src="/images/techsavvy-logo.webp" width="608" height="170" alt="TechSavvy Consulting" loading="lazy" /></a><p>Practical IT.<br/>Personal relationships.<br/>A local partner for your business.</p><div class="social-links"><a href="https://www.linkedin.com/company/techsavvy-consulting/" rel="noopener noreferrer" target="_blank">LinkedIn <span>↗</span></a><a href="https://www.facebook.com/techsavvyok/" rel="noopener noreferrer" target="_blank">Facebook <span>↗</span></a><a href="https://www.instagram.com/techsavvyok/" rel="noopener noreferrer" target="_blank">Instagram <span>↗</span></a></div></div>
        <div><h2>How we help</h2><ul>{services.slice(0,4).map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></div>
        <div><h2>TechSavvy</h2><ul><li><a href="/about-it-support">About us</a></li><li><a href="/it-support-business-tulsa">Our approach</a></li><li><a href="/tulsa-it-faq">Common questions</a></li><li><a href="/blog">TechSavvy blog</a></li><li><a href="/contact">Contact us</a></li></ul></div>
        <div class="footer-contact"><h2>Let’s connect</h2><a class="footer-phone" href="tel:+19184002424">(918) 400-2424</a><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a><p>5840 S Memorial Dr<br/>Tulsa, OK 74145</p><p>Monday–Friday<br/>8:00am–5:00pm Central</p></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} TechSavvy Consulting, LLC.</span><div><a href="/english-privacy-policy">Privacy policy</a><a href="/accessibility-statement">Accessibility</a><span class="footer-review">Review version · Not the live website</span></div></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.primary-navigation');
      const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label','Open navigation'); nav?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => {const opened=toggle.getAttribute('aria-expanded')==='true'; toggle.setAttribute('aria-expanded',String(!opened)); toggle.setAttribute('aria-label',opened?'Open navigation':'Close navigation'); nav?.classList.toggle('is-open',!opened);});
      document.addEventListener('keydown',event=>{if(event.key==='Escape'){closeMenu();document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach(x=>x.open=false);}});
      nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
      document.addEventListener('click',event=>{document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach(detail=>{if(event.target instanceof Node && !detail.contains(event.target))detail.open=false;});});
    </script>
  </body>
</html>
