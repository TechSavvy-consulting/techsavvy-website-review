---
import { previewPath } from '../utils/preview-path';
import type { BlogPost } from '../data/blog';
import Icon from './Icon.astro';
import Cta from './Cta.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<header class="page-hero">
  <div class="container narrow">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={previewPath('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={previewPath('/blog')}>Blog</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Article</span>
    </nav>
    <span class="eyebrow">{post.category}</span>
    <h1 id="article-title">{post.title}</h1>
    <div class="article-meta">
      <img src={previewPath('/images/kyle-hearn.webp')} alt="" width="35" height="35" decoding="async" />
      <span>By {post.author}</span>
      <span aria-hidden="true">·</span>
      <span>{post.updatedDate || post.archived ? 'Originally published' : 'Published'} <time datetime={post.date}>{post.displayDate}</time></span>
      {post.updatedDate && <><span aria-hidden="true">·</span><span>Updated <time datetime={post.updatedDate}>{post.displayUpdatedDate}</time></span></>}
      <span aria-hidden="true">·</span>
      <span>{post.readMinutes} min read</span>
    </div>
  </div>
</header>

<div class="section">
  <div class="container article-layout">
    <article class="article-body" aria-labelledby="article-title">
      <img
        class="article-cover"
        src={previewPath(post.image)}
        alt={post.imageAlt}
        width="1200"
        height="632"
        decoding="async"
      />
      {post.sections.map((section, index) => (
        <div>
          {section.heading && <h2 id={`article-section-${index + 1}`}>{section.heading}</h2>}
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {section.bullets && section.bullets.length > 0 && (
            <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>
          )}
        </div>
      ))}
      {post.sources && post.sources.length > 0 && <div class="article-note">
        <strong>Further reading</strong>
        <ul>{post.sources.map(source => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer" aria-label={`${source.label} (opens in a new tab)`} title="Opens in a new tab">{source.label}</a></li>
        ))}</ul>
      </div>}
      <p><a class="text-link" href={previewPath('/blog')}>Explore more articles <Icon name="arrow" size={18} /></a></p>
    </article>

    <aside class="article-aside" aria-labelledby="article-contact-title">
      <span class="eyebrow">Local IT. Personal service.</span>
      <h2 id="article-contact-title">What does this mean for your business?</h2>
      <p>Talk through your current systems, priorities, and support needs with TechSavvy.</p>
      <a class="button button-primary" href={previewPath('/contact')}>Start a conversation <Icon name="arrow" size={17} /></a>
      <p><a class="text-link" href="tel:+19184002424"><Icon name="phone" size={17} />(918) 400-2424</a></p>
      <a class="text-link" href={previewPath('/outsourced-managed-it')}>Explore managed IT <Icon name="arrow" size={17} /></a>
    </aside>
  </div>
</div>

<Cta
  title="Turn IT questions into a practical plan."
  text="Tell us what is working, what is frustrating, and what your business needs next."
/>
