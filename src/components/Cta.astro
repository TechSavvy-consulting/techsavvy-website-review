---
import { previewPath } from '../utils/preview-path';
import Icon from './Icon.astro';
const { title = 'Your next chapter. The right IT partner.', text = 'Let’s talk about your business, your priorities and what comes next.', buttonText = 'Let’s talk about your IT' } = Astro.props;
---
<section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow light">A conversation is a good place to start</span><h2>{title}</h2><p>{text}</p></div><a class="button button-white" href={previewPath('/contact')}>{buttonText} <Icon name="arrow" size={19}/></a></div></section>
