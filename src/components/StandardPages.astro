---
import { previewPath } from '../utils/preview-path';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import Cta from './Cta.astro';
import { credentials } from '../data/credentials';

interface Props {
  path: string;
}

const { path } = Astro.props;

const questions = [
  {
    question: 'What types of businesses do you work with?',
    answer: 'We focus on organizations in Tulsa County, typically with 10–100 computer or device users. Smaller businesses with servers or more complex systems can also be a good fit. We start with your goals, environment and current support to understand the partnership you need.',
  },
  {
    question: 'How long has TechSavvy been in business?',
    answer: 'TechSavvy Consulting was founded in 2015. Founder and Chief Technology Officer Kyle E. Hearn brings decades of business technology experience, including IT strategy, servers, networks and project management.',
  },
  {
    question: 'What areas do you cover?',
    answer: 'Our focus is Tulsa County. We combine remote support with on-site arrangements suited to your business, with support hours and responsibilities defined in your service plan.',
  },
  {
    question: 'What is included in managed IT support?',
    answer: 'A managed IT relationship connects day-to-day support with monitoring, maintenance, security, backup management and planning. We shape the services around your computers, servers, cloud tools, network and mobile devices, with clear responsibilities and costs.',
  },
  {
    question: 'Can you help with IT direction and planning?',
    answer: 'Yes. Our IT director and virtual CIO guidance connects technology decisions to your business goals. We help prioritize improvements, plan equipment life cycles and budgets, coordinate vendors, and prepare for new hires, locations or systems.',
  },
  {
    question: 'Can you fix things while we keep working?',
    answer: 'Some troubleshooting and repairs can be completed remotely in the background while you keep working. Other issues need your participation, a restart, or an onsite visit. We explain what is involved and coordinate the next step with you.',
  },
  {
    question: 'Can you work with our existing IT team?',
    answer: 'Yes. Co-managed IT pairs our Remote Managed IT service with your internal staff or local technician. We handle the help desk, monitoring, maintenance, updates, security and backup oversight; your local people handle onsite troubleshooting and hands-on work. IT guidance and vendor coordination keep the work connected.',
  },
  {
    question: 'Can you help us choose hardware and software?',
    answer: 'Yes. We help evaluate hardware, software and business applications against your needs and budget. We can coordinate with vendors and plan purchasing, setup and ongoing management so the pieces work together.',
  },
  {
    question: 'When is support available?',
    answer: 'Business hours are Monday–Friday, 8 AM–5 PM Central Time. Emergency support outside those hours is available according to your service plan.',
  },
  {
    question: 'How do we get started?',
    answer: 'Call or email us with a little information about your business, your current IT setup, and what you want to improve. We will talk through the need and discuss an appropriate next step. Scope and expectations are agreed before any work begins.',
  },
];
---

{path === '/about-it-support' && (
  <>
    <section class="page-hero" aria-labelledby="about-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">About TechSavvy</span>
        </nav>
        <div class="page-hero-grid">
          <div>
            <span class="eyebrow">Your Tulsa County IT partner</span>
            <h1 id="about-heading">Technology support built around your success.</h1>
            <p class="lead">From everyday support to IT director-level planning, we connect your technology to the way your business works. You get practical guidance, clear communication and a partner who cares about what comes next.</p>
            <div class="button-group">
              <a class="button button-primary" href={previewPath('/contact')}>Let’s talk about your IT <Icon name="arrow" size={19} /></a>
            </div>
          </div>
          <figure class="founder-card">
            <img src={previewPath('/images/kyle-hearn.webp')} class="page-hero-portrait" width="1254" height="1254" alt="Kyle E. Hearn, founder of TechSavvy Consulting" />
            <figcaption class="founder-label"><strong>Kyle E. Hearn</strong><span>Founder &amp; Chief Technology Officer</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="company-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">TechSavvy Consulting</span>
          <h2 id="company-heading">A complete view of your IT.</h2>
        </div>
        <div>
          <p>Founded in 2015, TechSavvy Consulting helps Tulsa County organizations manage the technology their people depend on. We typically serve businesses with 10–100 computer or device users, along with smaller organizations that have servers or more complex needs.</p>
          <p>We bring support, maintenance, security and planning into a connected working relationship. Computers, servers, networks, cloud services and mobile devices are considered together, with services shaped around your environment.</p>
          <p>Whether we serve as your IT partner or work alongside your internal staff, we help coordinate vendors, prioritize improvements and prepare for growth. Our IT director and virtual CIO guidance keeps technology decisions connected to your business goals.</p>
        </div>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="founder-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">Founder &amp; Chief Technology Officer</span>
          <h2 id="founder-heading">Meet Kyle E. Hearn.</h2>
        </div>
        <div>
          <p>Kyle E. Hearn is an entrepreneur and technology leader with decades of experience in business IT strategy, process development, servers, networks and project management. His career includes building and leading technology companies and helping organizations turn complex IT needs into practical plans.</p>
          <p>As TechSavvy’s founder and Chief Technology Officer, Kyle brings both a business owner’s perspective and hands-on technical experience. He cares about understanding people’s goals, explaining their options clearly and helping their businesses grow.</p>
          <p><a class="text-link" href={previewPath('/it-support-business-tulsa')}>Why TechSavvy <Icon name="arrow" size={18} /></a></p>
        </div>
      </div>
    </section>
    <section class="section" id="why-we-serve" aria-labelledby="serve-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">Why we serve</span>
          <h2 id="serve-heading">Care is part of how we work.</h2>
        </div>
        <div>
          <p>Our love for Jesus is at the heart of why we serve. We express it through honest guidance, dependable support, and care for our clients and our Tulsa community.</p>
          <p>We welcome businesses of every background. Listening well, treating people with respect and following through on our commitments are part of the relationship we work to build.</p>
        </div>
      </div>
    </section>
    <section class="section section-pale" id="credentials" aria-labelledby="credentials-heading">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Ongoing professional development</span>
          <h2 id="credentials-heading">Training behind our guidance.</h2>
          <p>Individual credentials earned by Kyle E. Hearn in cybersecurity fundamentals, healthcare information responsibilities and practical AI.</p>
        </div>
        <div class="service-grid">
          {credentials.map(credential => (
            <article class="service-card compact-card">
              <span class="icon-box"><Icon name={credential.icon} size={24} /></span>
              <h3>{credential.title}</h3>
              <p><strong>{credential.issuer}</strong><br />{credential.description}</p>
              <p>{credential.status}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <Cta title="Let’s get to know your business." text="Tell us what is working, what is getting in the way, and what you would like your IT support to look like." />
  </>
)}

{path === '/contact' && (
  <>
    <section class="page-hero" aria-labelledby="contact-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span>
        </nav>
        <span class="eyebrow">Let’s plan what comes next</span>
        <h1 id="contact-heading">What do you need from your IT partner?</h1>
        <p class="lead">Tell us about your business, your current technology and what you would like to improve. We will start with your goals and help identify a practical next step.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="contact-details-heading">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="eyebrow">Serving Tulsa County</span>
          <h2 id="contact-details-heading">Let’s talk about your IT.</h2>
          <p>Looking for a complete IT partner, support alongside your internal staff, or clearer IT direction? Start with a conversation about how your business works.</p>
          <div class="contact-details">
            <div class="contact-detail">
              <Icon name="phone" size={23} />
              <div><small>Give us a call</small><a class="phone-large" href="tel:+19184002424">(918) 400-2424</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="mail" size={23} />
              <div><small>Send us an email</small><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="pin" size={23} />
              <div><small>Our location</small><p>5840 S Memorial Dr<br />Tulsa, OK 74145</p></div>
            </div>
            <div class="contact-detail">
              <Icon name="clock" size={23} />
              <div><small>Business hours</small><p>Monday–Friday, 8 AM–5 PM Central Time</p><p>Emergency support outside business hours is available per service plan.</p></div>
            </div>
          </div>
        </div>
        <ContactForm id="contact-page" />
      </div>
    </section>
  </>
)}

{path === '/tulsa-it-faq' && (
  <>
    <section class="page-hero" aria-labelledby="faq-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Frequently Asked Questions</span>
        </nav>
        <span class="eyebrow">A little clarity before we talk</span>
        <h1 id="faq-heading">Your IT questions, answered.</h1>
        <p class="lead">Get to know how TechSavvy works, who we help, and what to expect when you start a conversation about support.</p>
      </div>
    </section>

    <section class="section" aria-label="Frequently asked questions">
      <div class="container narrow">
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <div><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <Cta title="Have a question about your own setup?" text="Every business has a different starting point. Tell us about yours, and we can talk through what makes sense next." />
  </>
)}
