---
import { previewPath } from '../utils/preview-path';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import Cta from './Cta.astro';
import { credentials } from '../data/credentials';

interface Props {
  path: string;
}

const { path } = Astro.props;

const questionGroups = [
  {
    id: 'working-together',
    title: 'Working together',
    description: 'A relationship that fits your people and your business.',
    icon: 'people',
    questions: [
      {
        question: 'What types of businesses do you work with?',
        answer: 'We typically support organizations with 10–100 computer or device users. Smaller businesses with servers or more involved technology can be a good fit, too. What matters most is understanding how your people work and building the right support around them.',
      },
      {
        question: 'Can you be our IT department or work alongside our team?',
        answer: 'It’s your choice. We can act as your entire IT department or work alongside your people. Either way, we connect everyday support, proactive care and IT planning so you have a partner who understands your business and helps it move forward.',
      },
      {
        question: 'Where can you support us?',
        answer: 'We provide remote support beyond Tulsa and on-location support for Tulsa County businesses. For locations farther away, we can work with your staff or a local technician for hands-on needs while we manage connected devices, servers, cloud tools and day-to-day support remotely.',
      },
      {
        question: 'How long has TechSavvy been in business?',
        answer: 'TechSavvy Consulting was founded in 2015. Our founder, Kyle Erik Hearn, started Mentor Technologies in 1998. That experience in technology and business ownership informs how we help customers today: with practical guidance and a long-term view of their success.',
      },
    ],
  },
  {
    id: 'everyday-support',
    title: 'Your everyday IT',
    description: 'Support for your people. Ongoing care for your technology.',
    icon: 'settings',
    questions: [
      {
        question: 'What does managed IT take care of?',
        answer: 'We bring together help desk support, monitoring, maintenance, tested updates, security, backup oversight and IT guidance. Computers, servers, networks, mobile devices and cloud services are considered together. Full and Remote Managed IT both include proactive care, with the service plan tailored to your business.',
      },
      {
        question: 'How does support fit into our working day?',
        answer: 'We handle much of your routine care remotely in the background and coordinate work that needs your involvement. Your people have someone to call for help with devices, email, access and business applications, while we plan maintenance around the way your business works.',
      },
      {
        question: 'When is support available?',
        answer: 'Our business hours are Monday–Friday, 8am–5pm Central. Emergency support outside those hours is available according to your service plan. We agree on how to reach us and what to expect, so your people know where to turn.',
      },
    ],
  },
  {
    id: 'moving-forward',
    title: 'Moving your business forward',
    description: 'Clear direction, useful improvements and a friendly first step.',
    icon: 'layers',
    questions: [
      {
        question: 'Can you help us plan as we grow?',
        answer: 'Yes. Our IT director-level guidance connects technology to your goals. We help prioritize improvements, plan equipment and budgets, coordinate vendors, and prepare for new people, locations or systems. You get a practical path forward, not just a list of things to buy.',
      },
      {
        question: 'Can you help our tools work better together?',
        answer: 'We help you choose and manage devices, Microsoft 365, Google Workspace and business cloud applications around the way you work. We also coordinate technology vendors, so purchasing, setup and ongoing support stay connected instead of becoming more work for your people.',
      },
      {
        question: 'Can you help us use AI and automation?',
        answer: 'Yes. We help set up AI for your people, guide practical use and develop automated workflows or simple custom software around a useful business need. We consider your data, access and review needs as we build. AI guidance and development are add-on projects, scoped and priced separately from managed IT support.',
      },
      {
        question: 'What is the first conversation like?',
        answer: 'Start with a call or email—there’s no need to have all the technical answers. We’ll get to know your business, listen to what matters to you and explore what is working well. Together, we’ll identify useful next steps and explain the options clearly before you decide.',
      },
    ],
  },
];
---

{path === '/about-it-support' && (
  <>
    <section class="page-hero" aria-labelledby="about-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">About TechSavvy</span>
        </nav>
        <div class="page-hero-grid">
          <div>
            <span class="eyebrow">Your Tulsa County IT partner</span>
            <h1 id="about-heading">Technology support built around your success.</h1>
            <p class="lead">From everyday support to IT director-level planning, we connect your technology to the way your business works. You get practical guidance, clear communication and a partner who cares about what comes next.</p>
            <div class="button-group">
              <a class="button button-primary" href={previewPath('/contact')}>Let’s talk about your IT <Icon name="arrow" size={19} /></a>
            </div>
          </div>
          <figure class="founder-card">
            <img src={previewPath('/images/kyle-hearn-slate.webp')} class="page-hero-portrait" width="1000" height="1000" alt="Kyle Erik Hearn, founder of TechSavvy Consulting" />
            <figcaption class="founder-label"><strong>Kyle Erik Hearn</strong><span>Founder &amp; Chief Technology Officer</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="company-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">TechSavvy Consulting</span>
          <h2 id="company-heading">A complete view of your IT.</h2>
        </div>
        <div>
          <p>Founded in 2015, TechSavvy Consulting helps Tulsa County organizations manage the technology their people depend on. We typically serve businesses with 10–100 computer or device users, along with smaller organizations that have servers or more complex needs.</p>
          <p>We bring support, maintenance, security and planning into a connected working relationship. Whether we serve as your IT partner or work alongside your internal staff, we help coordinate vendors, prioritize improvements and prepare for growth. Our IT director-level guidance keeps technology decisions connected to your business goals.</p>
        </div>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="founder-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">Founder &amp; Chief Technology Officer</span>
          <h2 id="founder-heading">Meet Kyle Erik Hearn.</h2>
        </div>
        <div>
          <p>Kyle Erik Hearn started Mentor Technologies in 1998 and grew it to serve over 1,000 customers across 35+ states. Building that business gave him a firsthand understanding of what organizations need from technology—and how much a dependable IT relationship matters.</p>
          <p>After selling the business, Kyle took five years off. That time confirmed that technology and serving people were more than a career: they were his passion. He founded TechSavvy Consulting in 2015, bringing together a business owner’s perspective and decades of hands-on experience in IT strategy, servers, networks and project management.</p>
          <p>Today, as founder and Chief Technology Officer, Kyle helps customers turn their goals into practical plans. He loves serving the Tulsa community, and putting his experience to work for local businesses is one way he gives back.</p>
          <p><a class="text-link" href={previewPath('/it-support-business-tulsa')}>Why TechSavvy <Icon name="arrow" size={18} /></a></p>
        </div>
      </div>
    </section>
    <section class="section" id="why-we-serve" aria-labelledby="serve-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">Why we serve</span>
          <h2 id="serve-heading">Care is part of how we work.</h2>
        </div>
        <div>
          <p>Our love for Jesus is at the heart of why we serve. We express it through honest guidance, dependable support, and care for our clients and our Tulsa community.</p>
          <p>We welcome businesses of every background. Listening well, treating people with respect and following through on our commitments are part of the relationship we work to build.</p>
        </div>
      </div>
    </section>
    <section class="section section-pale" id="credentials" aria-labelledby="credentials-heading">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Ongoing professional development</span>
          <h2 id="credentials-heading">Training behind our guidance.</h2>
          <p>Credentials held within our staff include cybersecurity fundamentals, healthcare information responsibilities and practical AI training.</p>
        </div>
        <div class="service-grid">
          {credentials.map(credential => (
            <article class="service-card compact-card">
              <span class="icon-box"><Icon name={credential.icon} size={24} /></span>
              <h3>{credential.title}</h3>
              <p><strong>{credential.issuer}</strong><br />{credential.description}</p>
              <p>{credential.status}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <Cta title="Let’s get to know your business." text="Tell us what is working, what is getting in the way, and what you would like your IT support to look like." />
  </>
)}

{path === '/contact' && (
  <>
    <section class="page-hero" aria-labelledby="contact-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span>
        </nav>
        <span class="eyebrow">Let’s plan what comes next</span>
        <h1 id="contact-heading">What do you need from your IT partner?</h1>
        <p class="lead">Tell us about your business, your current technology and what you would like to improve. We will start with your goals and help identify a practical next step.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="contact-details-heading">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="eyebrow">Serving Tulsa County</span>
          <h2 id="contact-details-heading">Let’s talk about your IT.</h2>
          <p>Looking for a complete IT partner, support alongside your internal staff, or clearer IT direction? Start with a conversation about how your business works.</p>
          <div class="contact-details">
            <div class="contact-detail">
              <Icon name="phone" size={23} />
              <div><small>Give us a call</small><a class="phone-large" href="tel:+19184002424">(918) 400-2424</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="mail" size={23} />
              <div><small>Send us an email</small><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="pin" size={23} />
              <div><small>Our location</small><p>5840 S Memorial Dr<br />Tulsa, OK 74145</p></div>
            </div>
            <div class="contact-detail">
              <Icon name="clock" size={23} />
              <div><small>Business hours</small><p>Monday–Friday, 8am–5pm Central</p><p>Emergency support outside business hours is available per service plan.</p></div>
            </div>
          </div>
        </div>
        <ContactForm id="contact-page" />
      </div>
    </section>
  </>
)}

{path === '/tulsa-it-faq' && (
  <>
    <section class="page-hero" aria-labelledby="faq-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Frequently Asked Questions</span>
        </nav>
        <span class="eyebrow">A little clarity before we talk</span>
        <h1 id="faq-heading">Your IT questions, answered.</h1>
        <p class="lead">A clear look at how we work, what we take care of and how we can help your business grow. Browse the answers below, or jump to what is on your mind.</p>
        <nav class="faq-topic-links" aria-label="Question topics">
          {questionGroups.map(group => (
            <a href={`#${group.id}`}><Icon name={group.icon} size={19} />{group.title}</a>
          ))}
        </nav>
      </div>
    </section>

    {questionGroups.map((group, groupIndex) => (
      <section class:list={['section', 'faq-answer-section', { 'section-soft': groupIndex % 2 === 1 }]} id={group.id} aria-labelledby={`${group.id}-heading`}>
        <div class="container faq-answer-layout">
          <div class="faq-topic-heading">
            <span class="icon-box"><Icon name={group.icon} size={25} /></span>
            <span class="eyebrow">{String(groupIndex + 1).padStart(2, '0')} / Your questions</span>
            <h2 id={`${group.id}-heading`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
          <div class="faq-answer-grid">
            {group.questions.map(({ question, answer }) => (
              <article class="faq-answer-card" id={question === 'When is support available?' ? 'support-hours' : undefined}>
                <h3>{question}</h3>
                <p>{answer}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
    <Cta title="Have a question about your own setup?" text="Every business has a different starting point. Tell us about yours, and we can talk through what makes sense next." />
  </>
)}

<style>
  .faq-topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .faq-topic-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 11px 16px;
    border: 1px solid #cbdce8;
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    font-size: .82rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .faq-topic-links a:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .faq-answer-section {
    padding-block: 76px;
    scroll-margin-top: 24px;
    border-bottom: 1px solid var(--line);
  }

  .faq-answer-layout {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 2fr);
    gap: 54px;
    align-items: start;
  }

  .faq-topic-heading .eyebrow {
    margin-top: 21px;
  }

  .faq-topic-heading h2 {
    margin-top: 12px;
    font-size: clamp(1.8rem, 2.4vw, 2.3rem);
    line-height: 1.2;
  }

  .faq-topic-heading p {
    margin-top: 16px;
    font-size: .94rem;
    line-height: 1.8;
  }

  .faq-answer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .faq-answer-card {
    scroll-margin-top: 24px;
    padding: 27px;
    border: 1px solid var(--line);
    border-top: 3px solid #94c7ec;
    border-radius: 12px;
    background: #fff;
  }

  .faq-answer-card h3 {
    font-size: 1.08rem;
    line-height: 1.45;
    letter-spacing: -.02em;
  }

  .faq-answer-card p {
    margin-top: 14px;
    font-size: .9rem;
    line-height: 1.85;
  }

  @media (max-width: 1000px) {
    .faq-answer-layout {
      grid-template-columns: 1fr;
      gap: 29px;
    }

    .faq-topic-heading {
      max-width: 620px;
    }
  }

  @media (max-width: 700px) {
    .founder-card {
      max-width: 400px;
    }

    .founder-card .page-hero-portrait {
      aspect-ratio: 1;
    }

    .founder-label {
      position: static;
      margin-top: 12px;
    }

    .faq-topic-links {
      gap: 10px;
    }

    .faq-topic-links a {
      font-size: .78rem;
    }

    .faq-answer-section {
      padding-block: 52px;
    }

    .faq-answer-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .faq-answer-card {
      padding: 23px;
    }
  }
</style>
