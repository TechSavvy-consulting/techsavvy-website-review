---
import { previewPath } from '../utils/preview-path';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import Cta from './Cta.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;

const questions = [
  {
    question: 'What types of businesses do you work with?',
    answer: 'TechSavvy primarily serves Tulsa-area organizations with 10–100 computer or device users. We work with businesses that need ongoing IT support, focused maintenance, project help, or additional support alongside an internal IT team. We start by understanding your environment and priorities to see whether we are a good fit.',
  },
  {
    question: 'How long has TechSavvy been in business?',
    answer: 'TechSavvy Consulting was founded in 2015. Founder Kyle E. Hearn brings experience in business IT strategy, process development, server and network technologies, and project management to the company’s work.',
  },
  {
    question: 'What areas do you cover?',
    answer: 'We provide onsite IT support in the Tulsa area and can discuss remote support for businesses in other locations. Contact us to confirm availability for your location and the kind of help you need. Onsite arrangements and support hours are established in your service plan.',
  },
  {
    question: 'What is included in managed IT support?',
    answer: 'A managed IT plan can bring together user support, system maintenance, monitoring, and practical IT planning. The covered devices, responsibilities, support hours, and any additional project work are agreed before service begins. We tailor the package to your business.',
  },
  {
    question: 'Can you fix things while we keep working?',
    answer: 'Some troubleshooting and repairs can be completed remotely in the background while you keep working. Other issues need your participation, a restart, or an onsite visit. We explain what is involved and coordinate the next step with you.',
  },
  {
    question: 'Can you work with our existing IT team?',
    answer: 'Yes. We can discuss co-managed support, complex troubleshooting, project assistance, or planned coverage that complements your internal team. Your team retains its role in setting priorities, and we agree on access, responsibilities, communication, and escalation procedures before starting.',
  },
  {
    question: 'Can you help us choose hardware and software?',
    answer: 'Yes. We can help evaluate equipment and software for your business needs and assist with procurement when appropriate. Depending on the situation, purchasing directly from a vendor may be the practical choice. We discuss the options and any related setup or support work with you.',
  },
  {
    question: 'How do we get started?',
    answer: 'Call or email us with a little information about your business, your current IT setup, and what you want to improve. We will talk through the need and discuss an appropriate next step. Scope and expectations are agreed before any work begins.',
  },
];
---

{path === '/about-it-support' && (
  <>
    <section class="page-hero" aria-labelledby="about-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">About TechSavvy</span>
        </nav>
        <div class="page-hero-grid">
          <div>
            <span class="eyebrow">Local expertise. A personal connection.</span>
            <h1 id="about-heading">Good IT starts with understanding your business.</h1>
            <p class="lead">We believe technology support should feel approachable, practical, and connected to the way you work. That is the relationship we build with businesses across the Tulsa area.</p>
            <div class="button-group">
              <a class="button button-primary" href={previewPath('/contact')}>Let’s talk about your IT <Icon name="arrow" size={19} /></a>
            </div>
          </div>
          <figure class="founder-card">
            <img src={previewPath('/images/kyle-hearn.webp')} class="page-hero-portrait" width="1254" height="1254" alt="Kyle E. Hearn, founder of TechSavvy Consulting" />
            <figcaption class="founder-label"><strong>Kyle E. Hearn</strong><span>Founder &amp; Chief Technology Officer</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="company-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">TechSavvy Consulting</span>
          <h2 id="company-heading">Built around long-term relationships.</h2>
        </div>
        <div>
          <p>Founded in 2015, TechSavvy Consulting helps businesses manage the technology their people depend on. We primarily serve organizations with 10–100 computer or device users, with support shaped around their systems, priorities, and existing resources.</p>
          <p>That can mean an ongoing managed IT relationship, regular maintenance, help with a specific project, or collaboration with an internal IT team. The starting point is the same: understand the need, explain the options, and agree on a clear scope.</p>
          <p>Our work connects everyday support with the bigger picture—computers, servers, networks, cloud services, backups, and the decisions that keep those systems useful to your business.</p>
        </div>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="founder-heading">
      <div class="container intro-grid">
        <div class="section-heading">
          <span class="eyebrow">Founder &amp; Chief Technology Officer</span>
          <h2 id="founder-heading">Meet Kyle E. Hearn.</h2>
        </div>
        <div>
          <p>Kyle’s interest in business and technology started early. At 17, he launched his first business, Mentor Technologies. His work has since spanned business IT strategy, process development, server and network technologies, and project management.</p>
          <p>As the owner of TechSavvy Consulting, Kyle brings that experience to the practical decisions businesses face: what needs attention now, what can be planned, and how technology can better support the people using it.</p>
          <p>The aim is a straightforward working relationship built on listening, clear communication, and useful technical advice.</p>
          <p><a class="text-link" href={previewPath('/it-support-business-tulsa')}>Explore our approach <Icon name="arrow" size={18} /></a></p>
        </div>
      </div>
    </section>
    <Cta title="Let’s get to know your business." text="Tell us what is working, what is getting in the way, and what you would like your IT support to look like." />
  </>
)}

{path === '/contact' && (
  <>
    <section class="page-hero" aria-labelledby="contact-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span>
        </nav>
        <span class="eyebrow">A conversation is a good place to start</span>
        <h1 id="contact-heading">What could better IT look like for you?</h1>
        <p class="lead">Tell us a little about your business and the help you need. We can talk through your priorities and discuss the right next step.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="contact-details-heading">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="eyebrow">Right here in Tulsa</span>
          <h2 id="contact-details-heading">Let’s talk about your IT.</h2>
          <p>Whether you need ongoing support, a second perspective, or help with a particular project, start with a call or an email.</p>
          <div class="contact-details">
            <div class="contact-detail">
              <Icon name="phone" size={23} />
              <div><small>Give us a call</small><a class="phone-large" href="tel:+19184002424">(918) 400-2424</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="mail" size={23} />
              <div><small>Send us an email</small><a href="mailto:sales@techsavvy.consulting">sales@techsavvy.consulting</a></div>
            </div>
            <div class="contact-detail">
              <Icon name="pin" size={23} />
              <div><small>Our location</small><p>5840 S Memorial Dr<br />Tulsa, OK 74145</p></div>
            </div>
            <div class="contact-detail">
              <Icon name="clock" size={23} />
              <div><small>Business hours</small><p>Monday–Friday, 8 AM–5 PM Central Time</p><p>After-hours support depends on your service agreement.</p></div>
            </div>
          </div>
        </div>
        <ContactForm id="contact-page" />
      </div>
    </section>
  </>
)}

{path === '/tulsa-it-faq' && (
  <>
    <section class="page-hero" aria-labelledby="faq-heading">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={previewPath('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Frequently Asked Questions</span>
        </nav>
        <span class="eyebrow">A little clarity before we talk</span>
        <h1 id="faq-heading">Your IT questions, answered.</h1>
        <p class="lead">Get to know how TechSavvy works, who we help, and what to expect when you start a conversation about support.</p>
      </div>
    </section>

    <section class="section" aria-label="Frequently asked questions">
      <div class="container narrow">
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <div><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <Cta title="Have a question about your own setup?" text="Every business has a different starting point. Tell us about yours, and we can talk through what makes sense next." />
  </>
)}
