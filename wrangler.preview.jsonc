{
  // Approved staging deployment only. No custom domains, routes or production deployment.
  // The existing video file is unchanged; this script supplies HTTP byte-range support.
  "name": "techsavvy-website-preview",
  "account_id": "a8cd243a690a05d7b1b7055272fa06a2",
  "main": "./cloudflare/video-worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/techsavvy-introduction.mp4"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
